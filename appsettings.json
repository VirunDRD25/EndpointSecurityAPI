{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "REPLACE_IN_RAILWAY"
  },

  "Jwt": {
    "Issuer": "EndpointSecurityAPI",
    "Audience": "EndpointSecurityDashboard",
    "Key": "REPLACE_IN_RAILWAY",
    "ExpiryHours": 8
  },

  "DefaultAdmin": {
    "Username": "admin",
    "Password": "admin123"
  },

  "AlertSettings": {
    "HighRiskThreshold": 50,
    "StaleDeviceMinutes": 30,
    "StaleDeviceSweepIntervalMinutes": 10
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
      "https://endpoint-security-dashboard.vercel.app/"
    ]
  }
}
